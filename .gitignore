# This is a filename safety net, not a secret scanner. Never embed credentials
# in tracked inventory, playbooks, templates, documentation, or workflows.
# Ignoring a file does not remove it from Git history or revoke leaked secrets.

# Environment files (commit only sanitized examples).
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# Local-only configuration and secret directories.
.secrets/
secrets/
credentials/
private/
*.local.yml
*.local.yaml
*.local.json
*.secrets.yml
*.secrets.yaml
*.secrets.json
secrets.yml
secrets.yaml
secrets.json
credentials.yml
credentials.yaml
credentials.json
service-account*.json
service_account*.json

# SSH/TLS private keys and identity bundles. Public keys/certificates are not
# secrets; PEM is excluded conservatively because it can contain private keys.
.ssh/
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_ecdsa_sk
id_ed25519_sk
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Ansible Vault passwords and plaintext local variable files.
# Intentionally do NOT ignore all vault.yml files: encrypted Vault content can
# be versioned after review, but its password must remain outside Git.
.vault_pass
.vault_pass.*
.vault-password
.vault-password.*
.vault_password
.vault_password.*
vault-pass*
vault_pass*
vault-password*
vault_password*
*.retry
.ansible/

# Terraform state, saved plans, variable values and credentials.
# Keep .terraform.lock.hcl tracked. Use *.tfvars.example for sanitized examples.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
tfplan
tfplan.*
*.plan
*.tfvars
*.tfvars.json
# Deliberately reviewed public configuration for the private/public GitOps repo.
# This file must contain PUBLIC SSH keys only, never API tokens/private keys.
!terraform/environments/router/router.tfvars
!terraform/environments/control-plane/control-plane.tfvars
!terraform/environments/workers/workers.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
credentials.tfrc.json

# Packer variable values and generated images/artifacts.
# Keep .pkr.hcl templates and dependency lock files tracked.
*.pkrvars.hcl
*.pkrvars.json
packer_cache/
.packer.d/
output-*/
*.qcow2
*.vmdk
*.vdi
*.vhd
*.vhdx
*.ova
*.iso

# GitHub runner installation, credentials, working copies and diagnostics.
actions-runner/
.runner
.credentials
.credentials_*
_work/
_diag/
actions-runner-*.tar.gz
actions-runner-*.zip

# Cloud CLI sessions and Kubernetes credentials.
.azure/
.aws/
.config/gcloud/
.kube/
kubeconfig
kubeconfig.*
*.kubeconfig
admin.conf
super-admin.conf

# VPN credentials. Keep any sanitized templates under different example names.
.twingate/
twingate-service-key*.json
twingate-service-account*.json
wireguard/
wg*.conf
*.ovpn

# Logs, backups and editor swap files may contain secret values.
*.log
*.bak
*.backup
*.orig
*.swp
*.swo
*~
.DS_Store

# Local Python environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Sanitized examples remain trackable (review contents before adding).
!*.example
!*.sample
!*.template
